# Optional override for a custom domain or hosting that cannot expose its public URL.
# Vercel production uses its primary domain automatically; Netlify/Render are also detected.
# NEXT_PUBLIC_SITE_URL=https://your-official-domain.com
# Server-only alternative (use one override, not both):
# SITE_URL=https://your-official-domain.com
# Local development and recognised deployment previews remain noindex.
# Rebuild/redeploy after changing the domain or a URL setting.

# GitHub Pages defaults: https://greenthera.shivantra.com/vaidehicraft.com/
# These configure only npm run build:pages / npm run deploy.
# PAGES_ORIGIN=https://greenthera.shivantra.com
# PAGES_BASE_PATH=/vaidehicraft.com
